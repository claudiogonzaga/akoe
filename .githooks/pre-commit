#!/bin/sh
#
# Zera as saídas de execução de todo .ipynb antes do commit.
#
# As saídas guardam nomes reais de arquivos, IDs de pasta e links de
# documentos. Como este repositório é público, elas não devem ser versionadas.
#
# Instalação (uma vez por clone):
#   git config core.hooksPath .githooks
#
# Para pular pontualmente:  git commit --no-verify

python3 - "$@" <<'PYEOF'
import json
import subprocess
import sys

# Notebooks staged para commit (adicionados/copiados/modificados/renomeados)
res = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
    capture_output=True, text=True, check=True,
)
notebooks = [p for p in res.stdout.splitlines() if p.endswith(".ipynb")]
if not notebooks:
    sys.exit(0)

limpos = []
for path in notebooks:
    try:
        with open(path, encoding="utf-8") as f:
            nb = json.load(f)
    except (OSError, json.JSONDecodeError):
        # Arquivo ilegível ou não é JSON válido: não é papel do hook decidir,
        # deixa o commit seguir.
        continue

    alterou = False
    for cell in nb.get("cells", []):
        if cell.get("cell_type") != "code":
            continue
        if cell.get("outputs"):
            cell["outputs"] = []
            alterou = True
        if cell.get("execution_count") is not None:
            cell["execution_count"] = None
            alterou = True

    if alterou:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(nb, f, indent=2, ensure_ascii=False)
        subprocess.run(["git", "add", path], check=True)
        limpos.append(path)

if limpos:
    print("🧹 pre-commit: saídas removidas de " + ", ".join(limpos))
PYEOF
